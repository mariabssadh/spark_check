# PostgreSQL (used by db, api, evidently and grafana)
POSTGRES_USER=spark
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spark_check

# Grafana login (username: admin)
GRAFANA_ADMIN_PASSWORD=change-me

# Set this in .env and pass the same value to Grafana and the monitoring-alerts service.
MONITORING_ALERT_PASSWORD=change-me